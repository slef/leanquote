% leanquote.sty -- typeset Lean declarations by name, copied verbatim from Lean sources.
%
%   \leanquotesetup{project=../lean/}            % root of the Lake project (optional)
%   \leanquotesetup{file=Path/To/File.lean}       % default file
%   \leanquote[options]{Name1, Name2, ...}        % quote from the current file
%   \leanquote[imports]{}                        % its import block
%   \leanquote[imports]{Name1, Name2, ...}       % imports, then declarations
%   \leanquote[file=Path/To/File.lean,options]{Name1, Name2, ...}   % explicit file
%
% A declaration is found by its `def`/`theorem`/... line in column 0 and runs while lines are
% indented (or start with `|`, `termination_by`, `decreasing_by`, `deriving`); its doc comment
% is shown with the `doc` option. Names may be short (`Tiles`) or qualified (`Abstract.Tiles`).
% An unknown name is an error. If the file is newer than its compiled `.olean`
% (under `project`/.lake/build/lib/lean/), LaTeX warns that it may not be what Lean checked.
% Optional: if `leanquote-export` was run, its export (under `project`/.lake/build/leanquote/, or
% next to the `.lean` file) is used automatically for exact declaration boundaries, as long as
% the `.lean` file has not changed since; otherwise the `.lean` file is read directly.
%
% Copyright 2026 Stefan Langerman and Erik D. Demaine. MIT License.
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{leanquote}{2026-10-26}{0.18}{Typeset Lean declarations by name}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\RequirePackage{amssymb}
\tcbuselibrary{skins,breakable}
% listings' upquote uses \textquotedbl, which has no OT1 definition.
% Select T1 just for this symbol; leave the document's font encoding unchanged.
\ProvideTextCommand{\textquotedbl}{OT1}{\UseTextSymbol{T1}{\textquotedbl}}

% ---------------------------------------------------------------- options
\tl_new:N \l__leanquote_lst_tl
\tl_new:N \l_leanquote_file_tl
\tl_new:N \l_leanquote_verify_tl
\bool_new:N \l_leanquote_check_bool
\keys_define:nn { leanquote }
  {
    file  .tl_set:N   = \l_leanquote_file_tl ,
    file  .initial:n  = {} ,
    root  .tl_set:N   = \l_leanquote_root_tl ,
    root  .initial:n  = {} ,
    doc   .bool_set:N = \l_leanquote_doc_bool ,
    doc   .default:n  = true ,
    doc   .initial:n  = false ,
    imports .bool_set:N = \l_leanquote_imports_bool ,
    imports .default:n  = true ,
    imports .initial:n  = false ,
    proof .bool_set:N = \l_leanquote_proof_bool ,
    proof .default:n  = true ,
    proof .initial:n  = true ,
    style .tl_set:N   = \l_leanquote_style_tl ,
    style .initial:n  = leanquote ,
    box   .bool_set:N = \l_leanquote_box_bool ,
    box   .default:n  = true ,
    box   .initial:n  = true ,
    boxback .tl_set:N  = \l_leanquote_boxback_tl ,
    boxback .initial:n = black!3 ,
    boxframe .tl_set:N  = \l_leanquote_boxframe_tl ,
    boxframe .initial:n = black!45 ,
    logo  .tl_set:N   = \l_leanquote_logo_tl ,
    logo  .initial:n  = {} ,
    verify .choices:nn = { true , false , auto }
      { \tl_set_eq:NN \l_leanquote_verify_tl \l_keys_choice_tl } ,
    verify .default:n  = true ,
    verify .initial:n  = auto ,
    check  .meta:n     = { verify = #1 } ,
    check  .default:n  = true ,
    source .tl_set:N  = \l_leanquote_source_tl ,
    source .initial:n = {} ,
    project .tl_set:N  = \l_leanquote_project_tl ,
    project .initial:n = {} ,
    olean .tl_set:N   = \l_leanquote_olean_tl ,
    olean .initial:n  = {} ,
  }
\tl_new:N \l__leanquote_unknown_tl
\cs_new_protected:Npn \__leanquote_options:n #1
  {
    \keys_set_known:nnN { leanquote } {#1} \l__leanquote_unknown_tl
    \tl_if_blank:VF \l__leanquote_unknown_tl
      { \tl_put_right:Ne \l__leanquote_lst_tl { , \exp_not:V \l__leanquote_unknown_tl } }
  }
% Listings settings given to \leanquotesetup (unknown keys) are kept for the whole document
% (or group); those given to a quote are added to them.
\tl_new:N \l__leanquote_setuplst_tl
\NewDocumentCommand \leanquotesetup { m }
  {
    \tl_set_eq:NN \l__leanquote_lst_tl \l__leanquote_setuplst_tl
    \__leanquote_options:n {#1}
    \tl_set_eq:NN \l__leanquote_setuplst_tl \l__leanquote_lst_tl
  }

% ---------------------------------------------------------------- messages
\msg_new:nnn { leanquote } { not-found }
  { Lean~declaration~`#1'~not~found~in~#2. }
\msg_new:nnn { leanquote } { ambiguous }
  { Lean~name~`#1'~matches~several~declarations~in~#2;~using~the~first.~
    Use~a~fully~qualified~name. }
\msg_new:nnn { leanquote } { no-file }
  { File~`#1'~not~found. }
\msg_new:nnn { leanquote } { stale }
  { #1~has~changed~since~#2~was~exported.~The~code~shown~may~be~out~of~date:~
    rebuild~and~run~leanquote-export~again. }
\msg_new:nnn { leanquote } { uncompiled }
  { #1~is~newer~than~its~compiled~file~#2.~The~code~shown~may~not~be~what~Lean~checked~
    (the~quote~is~marked~UNVERIFIED):~run~lake~build. }
\msg_new:nnn { leanquote } { using-export }
  { Using~#2~for~exact~declaration~boundaries~of~#1. }
\msg_new:nnn { leanquote } { stale-fallback }
  { #1~has~changed~since~it~was~exported~to~#2.~Reading~#1~directly~instead;~
    re-run~leanquote-export~for~exact~declaration~boundaries. }
\msg_new:nnn { leanquote } { no-olean }
  { No~compiled~file~#2~for~#1,~so~leanquote~cannot~check~that~Lean~compiled~it~
    (verify=true:~the~quote~is~marked~UNVERIFIED).~Set~project~to~the~root~of~its~Lake~
    project~or~olean~to~the~compiled~file,~or~use~verify=auto. }
\msg_new:nnn { leanquote } { no-imports }
  { No~import~lines~found~at~the~top~of~#1. }
\msg_new:nnn { leanquote } { failed }
  { The~last~lake~build~of~#1~failed:~its~compiled~file~#2~is~missing~
    (the~quote~is~marked~UNVERIFIED).~Fix~the~Lean~file~and~run~lake~build. }
\msg_new:nnn { leanquote } { sorry-file }
  { #1~contains~sorry,~according~to~Lake's~build~log~(quotes~from~it~are~marked~
    SORRY~IN~FILE).~Run~leanquote-export~to~see~which~declarations~depend~on~it. }
\msg_new:nnn { leanquote } { sorry-decl }
  { Lean~declaration~#1~depends~on~sorry~(the~quote~is~marked~USES~SORRY). }
\msg_new:nnn { leanquote } { extra-axioms }
  { Lean~declaration~#1~depends~on~axioms~beyond~propext,~Classical.choice~and~
    Quot.sound:~#2~(the~quote~is~marked~EXTRA~AXIOMS). }
\msg_new:nnn { leanquote } { no-olean-auto }
  { No~compiled~file~#2~for~#1;~leanquote~cannot~check~it~here~(verify=auto). }

\cs_generate_variant:Nn \msg_warning:nnnn { nnnV , nnVn }
\cs_generate_variant:Nn \msg_error:nnn { nnV }
\cs_generate_variant:Nn \msg_error:nnnn { nnVV }
\cs_generate_variant:Nn \msg_info:nnnn { nnnV }
\cs_generate_variant:Nn \file_if_exist:nTF { V }
\cs_generate_variant:Nn \file_if_exist:nF { V }
\cs_generate_variant:Nn \file_if_exist:nT { V }
\cs_generate_variant:Nn \str_range:nnn { e }

% ---------------------------------------------------------------- state
\ior_new:N \g__leanquote_ior
\iow_new:N \g__leanquote_iow
\int_new:N \g__leanquote_count_int
\str_new:N \l__leanquote_name_str
\str_new:N \l__leanquote_file_str
\str_new:N \l__leanquote_out_str
\bool_new:N \l__leanquote_inside_bool
\bool_new:N \l__leanquote_found_bool
\bool_new:N \l__leanquote_first_bool
\int_new:N \l__leanquote_matches_int
\prop_new:N \g__leanquote_checked_prop

% Write one line to the output file.
% Lines of the declaration being extracted are collected in a buffer, then written.
\seq_new:N \l__leanquote_buf_seq
\cs_new_protected:Npn \__leanquote_write:n #1 { \seq_put_right:Nn \l__leanquote_buf_seq {#1} }

% ---------------------------------------------------------------- lexical scanning
% Mask comments and strings with spaces, keeping byte/character offsets into the original.
% Block comments and literal contexts persist across lines, including interpolation holes.
% Consumers use the mask for syntax and source offsets. Imports omit masked comments;
% declaration text stays untouched. This is a source fallback, not a Lean parser.
\str_new:N \l__leanquote_code_str
\str_new:N \l__leanquote_char_str
\str_new:N \l__leanquote_pair_str
\str_new:N \l__leanquote_tail_str
\str_new:N \l__leanquote_rawend_str
\seq_new:N \l__leanquote_literal_seq
% Stack: ordinary/interpolated/raw strings, interpolation holes, and braces in holes.
\seq_new:N \l__leanquote_context_seq
\str_new:N \l__leanquote_context_str
\bool_new:N \l__leanquote_interpolated_bool
\int_new:N \l__leanquote_hole_start_int
\bool_new:N \l__leanquote_hole_bool
\int_new:N \l__leanquote_comment_int
\int_new:N \l__leanquote_scan_int
\int_new:N \l__leanquote_length_int
\bool_new:N \l__leanquote_string_bool
\bool_new:N \l__leanquote_escape_bool
\bool_new:N \l__leanquote_continuation_bool
\bool_new:N \l__leanquote_string_continuation_bool
\bool_new:N \l__leanquote_literal_bool
\cs_new_protected:Npn \__leanquote_lex_reset:
  {
    \int_zero:N \l__leanquote_comment_int
    \seq_clear:N \l__leanquote_context_seq
    \bool_set_false:N \l__leanquote_interpolated_bool
    \bool_set_false:N \l__leanquote_string_bool
    \bool_set_false:N \l__leanquote_escape_bool
    \str_clear:N \l__leanquote_rawend_str
  }
\cs_new_protected:Npn \__leanquote_mask_literal:
  {
    \int_set:Nn \l_tmpa_int { \str_count:e { \seq_item:Nn \l__leanquote_literal_seq {1} } }
    \str_put_right:Ne \l__leanquote_code_str
      { \prg_replicate:nn { \l_tmpa_int } { \c_space_tl } }
    \int_add:Nn \l__leanquote_scan_int { \l_tmpa_int - 1 }
    \bool_set_true:N \l__leanquote_literal_bool
  }
\cs_new_protected:Npn \__leanquote_lex_code:N #1
  {
    \bool_set_false:N \l__leanquote_literal_bool
    \str_case:Vn \l__leanquote_char_str
      {
        {"}
          {
            \bool_if:NTF \l__leanquote_interpolated_bool
              { \seq_put_right:Nn \l__leanquote_context_seq {interpolated} }
              { \seq_put_right:Nn \l__leanquote_context_seq {string} }
            \bool_set_false:N \l__leanquote_interpolated_bool
            \bool_set_true:N \l__leanquote_literal_bool
            \str_put_right:Ne \l__leanquote_code_str { \c_space_tl }
          }
        {r}
          {
            \str_set:Ne \l__leanquote_tail_str { \str_range:Nnn #1 { \l__leanquote_scan_int } {-1} }
            \regex_extract_once:nVNTF { \A r (\x{23}*) " } \l__leanquote_tail_str \l__leanquote_literal_seq
              {
                \str_set:Ne \l__leanquote_rawend_str { " \seq_item:Nn \l__leanquote_literal_seq {2} }
                \bool_set_false:N \l__leanquote_interpolated_bool
                \seq_put_right:Nn \l__leanquote_context_seq {raw}
                \__leanquote_mask_literal:
              }
              { }
          }
        {'}
          {
            % An apostrophe in an identifier is not a character-literal opener.
            \str_set:Ne \l__leanquote_tail_str { \str_item:Nn #1 { \l__leanquote_scan_int - 1 } }
            \regex_match:nVT { \A [\s(\[\{,:=]? \Z } \l__leanquote_tail_str
              {
                \str_set:Ne \l__leanquote_tail_str { \str_range:Nnn #1 { \l__leanquote_scan_int } {-1} }
                \regex_extract_once:nVNTF { \A ' (?: [^'\\]+ | \\ . ) ' }
                  \l__leanquote_tail_str \l__leanquote_literal_seq
                  { \bool_set_false:N \l__leanquote_interpolated_bool \__leanquote_mask_literal: } { }
              }
          }
      }
    \bool_if:NF \l__leanquote_literal_bool
      {
        % In pdfTeX the delimiter occupies two bytes, in Unicode engines one.
        \bool_lazy_or:nnTF
          { \str_if_eq_p:Vn \l__leanquote_char_str {«} }
          { \str_if_eq_p:Vn \l__leanquote_pair_str {«} }
          {
            \str_set:Ne \l__leanquote_tail_str { \str_range:Nnn #1 { \l__leanquote_scan_int } {-1} }
            \regex_extract_once:nVNTF { \A « .*? » } \l__leanquote_tail_str \l__leanquote_literal_seq
              {
                \bool_set_false:N \l__leanquote_interpolated_bool
                \str_put_right:Ne \l__leanquote_code_str { \seq_item:Nn \l__leanquote_literal_seq {1} }
                \int_add:Nn \l__leanquote_scan_int
                  { \str_count:e { \seq_item:Nn \l__leanquote_literal_seq {1} } - 1 }
              }
              { \__leanquote_lex_plain: }
          }
          { \__leanquote_lex_plain: }
      }
  }
\cs_new_protected:Npn \__leanquote_lex_plain:
  {
    \str_put_right:NV \l__leanquote_code_str \l__leanquote_char_str
    % Conventional interpolators (s!, m!, custom name!) may have
    % whitespace and comments between their token and the quote.
    \str_if_eq:VnTF \l__leanquote_char_str {!}
      { \bool_set_true:N \l__leanquote_interpolated_bool }
      {
        \bool_if:NT \l__leanquote_interpolated_bool
          {
            \regex_match:nVF { \A \s \Z } \l__leanquote_char_str
              { \bool_set_false:N \l__leanquote_interpolated_bool }
          }
      }
  }
\cs_new_protected:Npn \__leanquote_mask_pair:
  {
    \str_put_right:Ne \l__leanquote_code_str { \c_space_tl \c_space_tl }
    \int_incr:N \l__leanquote_scan_int
  }
\cs_new_protected:Npn \__leanquote_lex_string:
  {
    \str_put_right:Ne \l__leanquote_code_str { \c_space_tl }
    \bool_if:NTF \l__leanquote_escape_bool
      { \bool_set_false:N \l__leanquote_escape_bool }
      {
        \str_if_eq:VnTF \l__leanquote_char_str { " }
          { \seq_pop_right:NN \l__leanquote_context_seq \l__leanquote_context_str }
          {
            \str_if_eq:eeT { \l__leanquote_char_str } { \c_backslash_str }
              { \bool_set_true:N \l__leanquote_escape_bool }
            \bool_lazy_and:nnT
              { \str_if_eq_p:Vn \l__leanquote_context_str {interpolated} }
              { \str_if_eq_p:ee { \l__leanquote_char_str } { \c_left_brace_str } }
              { \seq_put_right:Nn \l__leanquote_context_seq {hole} }
          }
      }
  }
\cs_new_protected:Npn \__leanquote_lex:N #1
  {
    \bool_set:Nn \l__leanquote_continuation_bool
      { \int_compare_p:nNn { \l__leanquote_comment_int } > {0} || \l__leanquote_string_bool }
    \bool_set_eq:NN \l__leanquote_string_continuation_bool \l__leanquote_string_bool
    \str_clear:N \l__leanquote_code_str
    \int_set:Nn \l__leanquote_length_int { \str_count:N #1 }
    \int_set:Nn \l__leanquote_scan_int {1}
    \int_while_do:nNnn { \l__leanquote_scan_int } < { \l__leanquote_length_int + 1 }
      {
        \str_set:Ne \l__leanquote_char_str { \str_item:Nn #1 { \l__leanquote_scan_int } }
        \str_set:Ne \l__leanquote_pair_str
          { \str_range:Nnn #1 { \l__leanquote_scan_int } { \l__leanquote_scan_int + 1 } }
        \int_compare:nNnTF { \l__leanquote_comment_int } > {0}
          {
            \str_case:VnF \l__leanquote_pair_str
              {
                {/-} { \int_incr:N \l__leanquote_comment_int \__leanquote_mask_pair: }
                {-/} { \int_decr:N \l__leanquote_comment_int \__leanquote_mask_pair: }
              }
              { \str_put_right:Ne \l__leanquote_code_str { \c_space_tl } }
          }
          {
            \str_clear:N \l__leanquote_context_str
            \seq_if_empty:NF \l__leanquote_context_seq
              { \seq_get_right:NN \l__leanquote_context_seq \l__leanquote_context_str }
            \str_case:VnF \l__leanquote_context_str
              {
                {string} { \__leanquote_lex_string: }
                {interpolated} { \__leanquote_lex_string: }
                {raw}
                  {
                    \str_put_right:Ne \l__leanquote_code_str { \c_space_tl }
                    \int_set:Nn \l_tmpa_int { \str_count:N \l__leanquote_rawend_str - 1 }
                    \str_set:Ne \l__leanquote_tail_str
                      { \str_range:Nnn #1 { \l__leanquote_scan_int } { \l__leanquote_scan_int + \l_tmpa_int } }
                    \str_if_eq:NNT \l__leanquote_tail_str \l__leanquote_rawend_str
                      {
                        \str_put_right:Ne \l__leanquote_code_str
                          { \prg_replicate:nn { \l_tmpa_int } { \c_space_tl } }
                        \int_add:Nn \l__leanquote_scan_int { \l_tmpa_int }
                        \seq_pop_right:NN \l__leanquote_context_seq \l__leanquote_context_str
                        \str_clear:N \l__leanquote_rawend_str
                      }
                  }
              }
              {
                \str_case:VnF \l__leanquote_pair_str
                  {
                    {/-} { \int_incr:N \l__leanquote_comment_int \__leanquote_mask_pair: }
                    {--}
                      {
                        \str_put_right:Ne \l__leanquote_code_str
                          { \prg_replicate:nn { \l__leanquote_length_int - \l__leanquote_scan_int + 1 } { \c_space_tl } }
                        \int_set_eq:NN \l__leanquote_scan_int \l__leanquote_length_int
                      }
                  }
                  {
                    % Scan hole code for nested literals/comments, but mask it
                    % completely. Braces in literals/comments never reach here.
                    \int_set:Nn \l__leanquote_hole_start_int { \str_count:N \l__leanquote_code_str }
                    \bool_set:Nn \l__leanquote_hole_bool { ! \seq_if_empty_p:N \l__leanquote_context_seq }
                    \bool_if:NT \l__leanquote_hole_bool
                      {
                        \str_if_eq:eeT { \l__leanquote_char_str } { \c_left_brace_str }
                          { \seq_put_right:Nn \l__leanquote_context_seq {brace} }
                        \str_if_eq:eeT { \l__leanquote_char_str } { \c_right_brace_str }
                          { \seq_pop_right:NN \l__leanquote_context_seq \l__leanquote_context_str }
                      }
                    \__leanquote_lex_code:N #1
                    \bool_if:NT \l__leanquote_hole_bool
                      {
                        \str_set:Ne \l__leanquote_code_str
                          {
                            \str_range:Nnn \l__leanquote_code_str {1} { \l__leanquote_hole_start_int }
                            \prg_replicate:nn
                              { \str_count:N \l__leanquote_code_str - \l__leanquote_hole_start_int } { \c_space_tl }
                          }
                      }
                  }
              }
          }
        \int_incr:N \l__leanquote_scan_int
      }
    \bool_set:Nn \l__leanquote_string_bool { ! \seq_if_empty_p:N \l__leanquote_context_seq }
  }

% ---------------------------------------------------------------- hiding proofs (proof=false)
% The mask preserves offsets, so only the proof assignment outside brackets is replaced.
% Definitions keep their bodies, including string and comment contents.
\int_new:N \l__leanquote_depth_int
\int_new:N \l__leanquote_pos_int
\int_new:N \l__leanquote_cut_int
\int_new:N \l__leanquote_prev_int
\bool_new:N \l__leanquote_intheorem_bool
\bool_new:N \l__leanquote_cutdone_bool
\str_new:N \l__leanquote_line_str
\cs_generate_variant:Nn \str_replace_all:Nnn { Nne }
\cs_new_protected:Npn \__leanquote_proof_brackets:
  {
    % pdfTeX reads UTF-8 bytes; padding keeps source offsets equal on all engines.
    \str_replace_all:Nne \l__leanquote_code_str { ⟨ }
      { ( \prg_replicate:nn { \str_count:n {⟨} - 1 } { \c_space_tl } }
    \str_replace_all:Nne \l__leanquote_code_str { ⦃ }
      { ( \prg_replicate:nn { \str_count:n {⦃} - 1 } { \c_space_tl } }
    \str_replace_all:Nne \l__leanquote_code_str { ⟩ }
      { ) \prg_replicate:nn { \str_count:n {⟩} - 1 } { \c_space_tl } }
    \str_replace_all:Nne \l__leanquote_code_str { ⦄ }
      { ) \prg_replicate:nn { \str_count:n {⦄} - 1 } { \c_space_tl } }
  }
\cs_new_protected:Npn \__leanquote_find_cut:N #1
  {
    \int_zero:N \l__leanquote_pos_int
    \int_zero:N \l__leanquote_cut_int
    \int_zero:N \l__leanquote_prev_int
    \str_map_inline:Nn #1
      {
        \int_incr:N \l__leanquote_pos_int
        \int_case:nn { `##1 }
          {
            { 40 }    { \int_incr:N \l__leanquote_depth_int }
            { 91 }    { \int_incr:N \l__leanquote_depth_int }
            { 123 }   { \int_incr:N \l__leanquote_depth_int }
            { 41 }    { \int_decr:N \l__leanquote_depth_int }
            { 93 }    { \int_decr:N \l__leanquote_depth_int }
            { 125 }   { \int_decr:N \l__leanquote_depth_int }
            { 61 }
              {
                \bool_lazy_and:nnT
                  { \int_compare_p:nNn { \l__leanquote_prev_int } = { 58 } }
