  colback=\l_leanquote_boxback_tl, colframe=\l_leanquote_boxframe_tl,
  boxrule=0.5pt, arc=2pt, left=6pt, right=6pt, top=3pt, bottom=3pt,
  overlay~unbroken~and~first={
    \file_if_exist:VTF \l_leanquote_logo_tl
      {
        \node[anchor=north~east, inner~sep=3pt, draw=\l_leanquote_boxframe_tl, fill=white,
          line~width=0.5pt, rounded~corners=2pt] (leanquotelogo) at (frame.north~east)
          { \includegraphics[height=1.6ex]{\l_leanquote_logo_tl} \leanquotelogomark } ;
        \tl_if_empty:NF \l__leanquote_mark_tl
          {
            \node[anchor=north~east, inner~sep=3pt, fill=red!75!black, rounded~corners=2pt]
              at ([xshift=-3pt]leanquotelogo.north~west) { \leanquotebadge{\l__leanquote_mark_tl} } ;
          }
      }
      {
        \tl_if_empty:NF \l__leanquote_mark_tl
          {
            \node[anchor=north~east, inner~sep=3pt, fill=red!75!black, rounded~corners=2pt]
