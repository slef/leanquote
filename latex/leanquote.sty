% Printed after the logo image. The Lean trademark policy requires the Lean logo to be
% accompanied by a small trademark symbol; redefine as empty for other logos.
\definecolor{leanquotelogoblue}{HTML}{386EE0}
\cs_new:Npn \leanquotelogomark
  {
    \raisebox { \dimexpr 1.6ex - \height \relax }
      { \scalebox{0.65} { \textcolor{leanquotelogoblue} { \fontsize{5}{5} \fontfamily{cmss} \selectfont TM } } }
  }
% \leanquotetrademark: the trademark notice, to be printed once per paper (e.g. in the
% acknowledgments).
\NewDocumentCommand \leanquotetrademark { }
  { Lean~and~the~Lean~logo~are~trademarks~of~Lean~FRO. }
% The mark shown on quotes that are not known to be fully checked by Lean:
% UNVERIFIED, USES SORRY, SORRY IN FILE or EXTRA AXIOMS. \leanquotebadge is drawn on a red
% background in the box; \leanquotebadgetext is used without a box.
\cs_new:Npn \leanquotebadge #1
  { \textcolor{white}{ \textsf{ \bfseries \scriptsize #1 } } }
\cs_new:Npn \leanquotebadgetext #1
  { \textcolor{red!75!black}{ \textsf{ \bfseries \scriptsize #1 } } }
