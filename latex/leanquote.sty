% leanquote.sty -- typeset Lean declarations by name, copied verbatim from Lean sources.
%
%   \leanquotesetup{project=../lean/}            % root of the Lake project (optional)
%   \leanquotesetup{file=Path/To/File.lean}       % default file
%   \leanquote[options]{Name1, Name2, ...}        % quote from the current file
%   \leanquote[imports]{}                        % its import block
%   \leanquote[imports]{Name1, Name2, ...}       % imports, then declarations
%   \leanquote[file=Path/To/File.lean,options]{Name1, Name2, ...}   % explicit file
%
% A declaration is found by its `def`/`theorem`/... line in column 0 and runs while lines are
% indented (or start with `|`, `termination_by`, `decreasing_by`, `deriving`,
% `partial_fixpoint`, `monotonicity_by`); its doc comment
% is shown with the `doc` option. Names may be short (`Tiles`) or qualified (`Abstract.Tiles`).
% An unknown name is an error. If the file is newer than its compiled `.olean`
% (under `project`/.lake/build/lib/lean/), LaTeX warns that it may not be what Lean checked.
% Optional: if `leanquote-export` was run, its export (under `project`/.lake/build/leanquote/, or
% next to the `.lean` file) is used automatically for exact declaration boundaries, as long as
% the `.lean` file has not changed since; otherwise the `.lean` file is read directly.
% V3 exports also supply prepared theorem statements for proof=false. Source-only
% and legacy proof hiding preserve the complete declaration when a cut is uncertain.
%
% Copyright 2026 Stefan Langerman and Erik D. Demaine. MIT License.
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{leanquote}{2026-10-27}{0.19}{Typeset Lean declarations by name}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\RequirePackage{amssymb}
\tcbuselibrary{skins,breakable}
% listings' upquote uses \textquotedbl, which has no OT1 definition.
% Select T1 just for this symbol; leave the document's font encoding unchanged.
\ProvideTextCommand{\textquotedbl}{OT1}{\UseTextSymbol{T1}{\textquotedbl}}

% ---------------------------------------------------------------- options
\tl_new:N \l__leanquote_lst_tl
\tl_new:N \l_leanquote_file_tl
\tl_new:N \l_leanquote_verify_tl
\bool_new:N \l_leanquote_check_bool
\keys_define:nn { leanquote }
  {
    file  .tl_set:N   = \l_leanquote_file_tl ,
    file  .initial:n  = {} ,
    root  .tl_set:N   = \l_leanquote_root_tl ,
    root  .initial:n  = {} ,
    doc   .bool_set:N = \l_leanquote_doc_bool ,
    doc   .default:n  = true ,
    doc   .initial:n  = false ,
    imports .bool_set:N = \l_leanquote_imports_bool ,
    imports .default:n  = true ,
    imports .initial:n  = false ,
    proof .bool_set:N = \l_leanquote_proof_bool ,
    proof .default:n  = true ,
    proof .initial:n  = true ,
    style .tl_set:N   = \l_leanquote_style_tl ,
    style .initial:n  = leanquote ,
    box   .bool_set:N = \l_leanquote_box_bool ,
    box   .default:n  = true ,
    box   .initial:n  = true ,
    boxback .tl_set:N  = \l_leanquote_boxback_tl ,
    boxback .initial:n = black!3 ,
    boxframe .tl_set:N  = \l_leanquote_boxframe_tl ,
    boxframe .initial:n = black!45 ,
    logo  .tl_set:N   = \l_leanquote_logo_tl ,
    logo  .initial:n  = {} ,
    verify .choices:nn = { true , false , auto }
      { \tl_set_eq:NN \l_leanquote_verify_tl \l_keys_choice_tl } ,
    verify .default:n  = true ,
    verify .initial:n  = auto ,
    check  .meta:n     = { verify = #1 } ,
    check  .default:n  = true ,
    source .tl_set:N  = \l_leanquote_source_tl ,
    source .initial:n = {} ,
    project .tl_set:N  = \l_leanquote_project_tl ,
    project .initial:n = {} ,
    olean .tl_set:N   = \l_leanquote_olean_tl ,
    olean .initial:n  = {} ,
  }
\tl_new:N \l__leanquote_unknown_tl
\cs_new_protected:Npn \__leanquote_options:n #1
  {
    \keys_set_known:nnN { leanquote } {#1} \l__leanquote_unknown_tl
    \tl_if_blank:VF \l__leanquote_unknown_tl
      { \tl_put_right:Ne \l__leanquote_lst_tl { , \exp_not:V \l__leanquote_unknown_tl } }
  }
% Listings settings given to \leanquotesetup (unknown keys) are kept for the whole document
% (or group); those given to a quote are added to them.
\tl_new:N \l__leanquote_setuplst_tl
\NewDocumentCommand \leanquotesetup { m }
  {
    \tl_set_eq:NN \l__leanquote_lst_tl \l__leanquote_setuplst_tl
    \__leanquote_options:n {#1}
    \tl_set_eq:NN \l__leanquote_setuplst_tl \l__leanquote_lst_tl
  }

% ---------------------------------------------------------------- messages
\msg_new:nnn { leanquote } { not-found }
  { Lean~declaration~`#1'~not~found~in~#2. }
\msg_new:nnn { leanquote } { ambiguous }
  { Lean~name~`#1'~matches~several~declarations~in~#2;~using~the~first.~
    Use~a~fully~qualified~name. }
\msg_new:nnn { leanquote } { no-file }
  { File~`#1'~not~found. }
\msg_new:nnn { leanquote } { stale }
  { #1~has~changed~since~#2~was~exported.~The~code~shown~may~be~out~of~date:~
    rebuild~and~run~leanquote-export~again. }
\msg_new:nnn { leanquote } { uncompiled }
  { #1~is~newer~than~its~compiled~file~#2.~The~code~shown~may~not~be~what~Lean~checked~
    (the~quote~is~marked~UNVERIFIED):~run~lake~build. }
\msg_new:nnn { leanquote } { using-export }
  { Using~#2~for~exact~declaration~boundaries~of~#1. }
\msg_new:nnn { leanquote } { stale-fallback }
  { #1~has~changed~since~it~was~exported~to~#2.~Reading~#1~directly~instead;~
    re-run~leanquote-export~for~exact~declaration~boundaries. }
\msg_new:nnn { leanquote } { no-olean }
  { No~compiled~file~#2~for~#1,~so~leanquote~cannot~check~that~Lean~compiled~it~
    (verify=true:~the~quote~is~marked~UNVERIFIED).~Set~project~to~the~root~of~its~Lake~
    project~or~olean~to~the~compiled~file,~or~use~verify=auto. }
\msg_new:nnn { leanquote } { no-imports }
  { No~import~lines~found~at~the~top~of~#1. }
\msg_new:nnn { leanquote } { failed }
  { The~last~lake~build~of~#1~failed:~its~compiled~file~#2~is~missing~
    (the~quote~is~marked~UNVERIFIED).~Fix~the~Lean~file~and~run~lake~build. }
\msg_new:nnn { leanquote } { sorry-file }
  { #1~contains~sorry,~according~to~Lake's~build~log~(quotes~from~it~are~marked~
    SORRY~IN~FILE).~Run~leanquote-export~to~see~which~declarations~depend~on~it. }
\msg_new:nnn { leanquote } { sorry-decl }
  { Lean~declaration~#1~depends~on~sorry~(the~quote~is~marked~USES~SORRY). }
\msg_new:nnn { leanquote } { extra-axioms }
  { Lean~declaration~#1~depends~on~axioms~beyond~propext,~Classical.choice~and~
    Quot.sound:~#2~(the~quote~is~marked~EXTRA~AXIOMS). }
\msg_new:nnn { leanquote } { no-olean-auto }
  { No~compiled~file~#2~for~#1;~leanquote~cannot~check~it~here~(verify=auto). }

\cs_generate_variant:Nn \msg_warning:nnnn { nnnV , nnVn }
\cs_generate_variant:Nn \msg_error:nnn { nnV }
\cs_generate_variant:Nn \msg_error:nnnn { nnVV }
\cs_generate_variant:Nn \msg_info:nnnn { nnnV }
\cs_generate_variant:Nn \file_if_exist:nTF { V }
\cs_generate_variant:Nn \file_if_exist:nF { V }
\cs_generate_variant:Nn \file_if_exist:nT { V }
