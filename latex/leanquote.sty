% leanquote.sty -- typeset Lean declarations by name, copied verbatim from Lean sources.
%
%   \leanquotesetup{project=../lean/}            % root of the Lake project (optional)
%   \leanfile{Path/To/File.lean}                  % current file
%   \leanquote[options]{Name1, Name2, ...}        % quote from the current file
%   \leanfilequote[options]{Path/To/File.lean}{Name1, Name2, ...}   % explicit file
%
% A declaration is found by its `def`/`theorem`/... line in column 0 and runs while lines are
% indented (or start with `|`, `termination_by`, `decreasing_by`, `deriving`); its doc comment
% is shown with the `doc` option. Names may be short (`Tiles`) or qualified (`Abstract.Tiles`).
% An unknown name is an error. If the file is newer than its compiled `.olean`
% (under `project`/.lake/build/lib/lean/), LaTeX warns that it may not be what Lean checked.
% Optional: if `leanquote-export` was run, its export (under `project`/.lake/build/leanquote/, or
% next to the `.lean` file) is used automatically for exact declaration boundaries, as long as
% the `.lean` file has not changed since; otherwise the `.lean` file is read directly.
%
% Copyright 2026 Stefan Langerman and Erik D. Demaine. MIT License.
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{leanquote}{2026-10-25}{0.5}{Typeset Lean declarations by name}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tcolorbox}
\RequirePackage{amssymb}
\tcbuselibrary{skins,breakable}

% ---------------------------------------------------------------- options
\tl_new:N \l__leanquote_lst_tl
\keys_define:nn { leanquote }
  {
    root  .tl_set:N   = \l_leanquote_root_tl ,
    root  .initial:n  = {} ,
    doc   .bool_set:N = \l_leanquote_doc_bool ,
    doc   .default:n  = true ,
    doc   .initial:n  = false ,
    style .tl_set:N   = \l_leanquote_style_tl ,
    style .initial:n  = leanquote ,
    box   .bool_set:N = \l_leanquote_box_bool ,
    box   .default:n  = true ,
    box   .initial:n  = true ,
    logo  .tl_set:N   = \l_leanquote_logo_tl ,
    logo  .initial:n  = {} ,
    check .bool_set:N = \l_leanquote_check_bool ,
    check .default:n  = true ,
    check .initial:n  = true ,
    source .tl_set:N  = \l_leanquote_source_tl ,
    source .initial:n = {} ,
    project .tl_set:N  = \l_leanquote_project_tl ,
    project .initial:n = {} ,
    olean .tl_set:N   = \l_leanquote_olean_tl ,
    olean .initial:n  = {} ,
    unknown .code:n   =
      \tl_put_right:Nx \l__leanquote_lst_tl
        { , \l_keys_key_str \tl_if_blank:nF {#1} { = \exp_not:n {#1} } } ,
  }
\NewDocumentCommand \leanquotesetup { m } { \keys_set:nn { leanquote } {#1} }

% ---------------------------------------------------------------- messages
\msg_new:nnn { leanquote } { not-found }
  { Lean~declaration~`#1'~not~found~in~#2. }
\msg_new:nnn { leanquote } { ambiguous }
  { Lean~name~`#1'~matches~several~declarations~in~#2;~using~the~first.~
    Use~a~fully~qualified~name. }
\msg_new:nnn { leanquote } { no-file }
  { File~`#1'~not~found. }
\msg_new:nnn { leanquote } { stale }
  { #1~has~changed~since~#2~was~exported.~The~code~shown~may~be~out~of~date:~
    rebuild~and~run~leanquote-export~again. }
\msg_new:nnn { leanquote } { uncompiled }
  { #1~is~newer~than~its~compiled~file~#2.~The~code~shown~may~not~be~what~Lean~checked:~
    run~lake~build. }
\msg_new:nnn { leanquote } { using-export }
  { Using~#2~for~exact~declaration~boundaries~of~#1. }
\msg_new:nnn { leanquote } { stale-fallback }
  { #1~has~changed~since~it~was~exported~to~#2.~Reading~#1~directly~instead;~
    re-run~leanquote-export~for~exact~declaration~boundaries. }
\msg_new:nnn { leanquote } { no-olean }
  { No~compiled~file~#2~for~#1;~cannot~check~that~it~was~compiled.~
    Set~the~project~option~to~the~root~of~its~Lake~project,~or~olean~to~the~file. }

\cs_generate_variant:Nn \msg_warning:nnnn { nnnV , nnVn }
\cs_generate_variant:Nn \msg_error:nnn { nnV }
\cs_generate_variant:Nn \msg_error:nnnn { nnVV }
\cs_generate_variant:Nn \msg_info:nnnn { nnnV }
\cs_generate_variant:Nn \file_if_exist:nTF { V }
\cs_generate_variant:Nn \file_if_exist:nF { V }
\cs_generate_variant:Nn \file_if_exist:nT { V }
\cs_generate_variant:Nn \str_range:nnn { e }

% ---------------------------------------------------------------- state
\ior_new:N \g__leanquote_ior
\iow_new:N \g__leanquote_iow
\int_new:N \g__leanquote_count_int
\str_new:N \l__leanquote_name_str
\str_new:N \l__leanquote_file_str
\str_new:N \l__leanquote_out_str
\bool_new:N \l__leanquote_inside_bool
\bool_new:N \l__leanquote_found_bool
\bool_new:N \l__leanquote_first_bool
\int_new:N \l__leanquote_matches_int
\prop_new:N \g__leanquote_checked_prop

% Write one line to the output file.
\cs_new_protected:Npn \__leanquote_write:n #1 { \iow_now:Nn \g__leanquote_iow {#1} }

% ---------------------------------------------------------------- .leanquote exports
\cs_new_protected:Npn \__leanquote_from_export:n #1
  {
    \bool_set_false:N \l__leanquote_inside_bool
    \bool_set_false:N \l__leanquote_found_bool
    \int_zero:N \l__leanquote_matches_int
    \ior_open:Nn \g__leanquote_ior {#1}
    \ior_str_map_inline:Nn \g__leanquote_ior
      {
        \bool_if:NTF \l__leanquote_inside_bool
          {
            \str_if_eq:nnTF {##1} { @@end }
              { \bool_set_false:N \l__leanquote_inside_bool }
              {
                \regex_match:nnTF { \A @@doc\x{20} } {##1}
                  {
                    \bool_if:NT \l_leanquote_doc_bool
                      { \iow_now:Ne \g__leanquote_iow { \str_range:nnn {##1} {7} {-1} } }
                  }
                  { \__leanquote_write:n {##1} }
              }
          }
          {
            \regex_match:nnT { \A @@begin\x{20} (.*\.)? \u{l__leanquote_name_str} \Z } {##1}
              {
                \int_incr:N \l__leanquote_matches_int
                \bool_if:NF \l__leanquote_found_bool
                  {
                    \bool_set_true:N \l__leanquote_inside_bool
                    \bool_set_true:N \l__leanquote_found_bool
                  }
              }
          }
      }
    \ior_close:N \g__leanquote_ior
  }

% ---------------------------------------------------------------- .lean files
% A declaration starts at a line `[@[...]] [modifiers] def|theorem|... Name` in column 0, with
% the doc comment and attribute lines just above it, and continues while lines are blank,
% indented, or start with `|`, `termination_by`, `decreasing_by` or `deriving`.
\seq_new:N \l__leanquote_doc_seq
\seq_new:N \l__leanquote_attr_seq
\seq_new:N \l__leanquote_blank_seq
\bool_new:N \l__leanquote_indoc_bool
\bool_new:N \l__leanquote_consumed_bool
\cs_new_protected:Npn \__leanquote_src_inside:n #1
  {
    \regex_match:nnTF { \A \s* \Z } {#1}
      { \seq_put_right:Nn \l__leanquote_blank_seq { } \bool_set_true:N \l__leanquote_consumed_bool }
      {
        \regex_match:nnTF { \A ( \s | \| | termination_by | decreasing_by | deriving ) } {#1}
          {
            \seq_map_inline:Nn \l__leanquote_blank_seq { \__leanquote_write:n { } }
            \seq_clear:N \l__leanquote_blank_seq
            \__leanquote_write:n {#1}
            \bool_set_true:N \l__leanquote_consumed_bool
          }
          {
            \bool_set_false:N \l__leanquote_inside_bool
            \seq_clear:N \l__leanquote_blank_seq
          }
      }
  }
\seq_new:N \l__leanquote_decl_seq
\str_new:N \l__leanquote_declname_str
% Does the declared name match the requested one? Either may be a dotted suffix of the other.
\cs_generate_variant:Nn \regex_match:nnTF { nV }
\prg_new_protected_conditional:Npnn \__leanquote_names_match: { TF }
  {
    \str_if_eq:NNTF \l__leanquote_declname_str \l__leanquote_name_str
      { \prg_return_true: }
      {
        \regex_match:nVTF { \. \u{l__leanquote_name_str} \Z } \l__leanquote_declname_str
          { \prg_return_true: }
          {
            \regex_match:nVTF { \. \u{l__leanquote_declname_str} \Z } \l__leanquote_name_str
              { \prg_return_true: } { \prg_return_false: }
          }
      }
  }
\cs_new_protected:Npn \__leanquote_src_start:n #1
  {
                \int_incr:N \l__leanquote_matches_int
                \bool_if:NF \l__leanquote_found_bool
                  {
                    \bool_set_true:N \l__leanquote_found_bool
                    \bool_set_true:N \l__leanquote_inside_bool
                    \bool_if:NT \l_leanquote_doc_bool
                      { \seq_map_inline:Nn \l__leanquote_doc_seq { \__leanquote_write:n {##1} } }
                    \seq_map_inline:Nn \l__leanquote_attr_seq { \__leanquote_write:n {##1} }
                    \__leanquote_write:n {#1}
                  }
              }
\cs_new_protected:Npn \__leanquote_src_other:n #1
  {
                \regex_match:nnTF { \A @\[ } {#1}
                  { \seq_put_right:Nn \l__leanquote_attr_seq {#1} }
                  {
                    \regex_match:nnF { \A \s* \Z } {#1}
                      {
                        \seq_clear:N \l__leanquote_doc_seq
                        \seq_clear:N \l__leanquote_attr_seq
                      }
                  }
              }
\cs_new_protected:Npn \__leanquote_src_outside:n #1
  {
    \bool_if:NTF \l__leanquote_indoc_bool
      {
        \seq_put_right:Nn \l__leanquote_doc_seq {#1}
        \regex_match:nnT { -/ } {#1} { \bool_set_false:N \l__leanquote_indoc_bool }
      }
      {
        \regex_match:nnTF { \A /-- } {#1}
          {
            \seq_clear:N \l__leanquote_doc_seq
            \seq_clear:N \l__leanquote_attr_seq
            \seq_put_right:Nn \l__leanquote_doc_seq {#1}
            \regex_match:nnF { \A /-- .* -/ } {#1} { \bool_set_true:N \l__leanquote_indoc_bool }
          }
          {
            \regex_extract_once:nnNTF
              { \A (?:@\[ [^\]]* \] \s*)?
                   (?:(?:private|protected|noncomputable|partial|unsafe|nonrec) \s+)*
                   (?:def|theorem|lemma|abbrev|structure|inductive|instance|class|axiom|opaque)
                   \s+ ([^\s:(\[\{]+) }
              {#1} \l__leanquote_decl_seq
              {
                \str_set:Ne \l__leanquote_declname_str { \seq_item:Nn \l__leanquote_decl_seq {2} }
                \__leanquote_names_match:TF { \__leanquote_src_start:n {#1} } { \__leanquote_src_other:n {#1} }
              }
              { \__leanquote_src_other:n {#1} }

          }
      }
  }
\cs_new_protected:Npn \__leanquote_from_source:n #1
  {
    \bool_set_false:N \l__leanquote_inside_bool
    \bool_set_false:N \l__leanquote_found_bool
    \bool_set_false:N \l__leanquote_indoc_bool
    \int_zero:N \l__leanquote_matches_int
    \seq_clear:N \l__leanquote_doc_seq
    \seq_clear:N \l__leanquote_attr_seq
    \seq_clear:N \l__leanquote_blank_seq
    \ior_open:Nn \g__leanquote_ior {#1}
    \ior_str_map_inline:Nn \g__leanquote_ior
      {
        \bool_set_false:N \l__leanquote_consumed_bool
        \bool_if:NT \l__leanquote_inside_bool { \__leanquote_src_inside:n {##1} }
        \bool_if:NF \l__leanquote_consumed_bool { \__leanquote_src_outside:n {##1} }
      }
    \ior_close:N \g__leanquote_ior
  }

% Compare modification dates of a `.lean` file and its compiled `.olean` (once per file per run).
\RequirePackage{pdftexcmds}
\str_new:N \l__leanquote_olean_str
\cs_new_protected:Npn \__leanquote_check_compiled:nn #1#2
  {% #1 = source path as read, #2 = path relative to the Lake project root
    \prop_if_in:NnF \g__leanquote_checked_prop {#1}
      {
        \prop_gput:Nnn \g__leanquote_checked_prop {#1} { }
        \tl_if_blank:VTF \l_leanquote_olean_tl
          {
            \str_set:Ne \l__leanquote_olean_str
              { \l_leanquote_project_tl .lake/build/lib/lean/ \str_range:nnn {#2} {1} {-6} .olean }
          }
          { \str_set:NV \l__leanquote_olean_str \l_leanquote_olean_tl }
        \file_if_exist:VTF \l__leanquote_olean_str
          {
            \str_compare:eNeT
              { \str_range:enn { \use:c { pdf@filemoddate } {#1} } {3} {16} }
              >
              { \str_range:enn { \use:c { pdf@filemoddate } { \l__leanquote_olean_str } } {3} {16} }
              { \msg_warning:nnnV { leanquote } { uncompiled } {#1} \l__leanquote_olean_str }
          }
          { \msg_info:nnnV { leanquote } { no-olean } {#1} \l__leanquote_olean_str }
      }
  }

% ---------------------------------------------------------------- freshness check
% Compare the source text stored in an export (`@@src` lines) with the current source file,
% found at `root` + the `@@source` path. Done once per export per run.
\str_new:N \l__leanquote_stored_str
\str_new:N \l__leanquote_current_str
\str_new:N \l__leanquote_srcpath_str
\cs_new_protected:Npn \__leanquote_check:n #1
  {
    \prop_if_in:NnF \g__leanquote_checked_prop {#1}
      {
        \prop_gput:Nnn \g__leanquote_checked_prop {#1} { }
        \str_clear:N \l__leanquote_stored_str
        \str_clear:N \l__leanquote_srcpath_str
        \ior_open:Nn \g__leanquote_ior {#1}
        \ior_str_map_inline:Nn \g__leanquote_ior
          {
            \regex_match:nnT { \A @@src\x{20} } {##1}
              { \str_put_right:Ne \l__leanquote_stored_str { \str_range:nnn {##1} {7} {-1} | } }
            \regex_match:nnT { \A @@src \Z } {##1}
              { \str_put_right:Nn \l__leanquote_stored_str { | } }
            \regex_match:nnT { \A @@source\x{20} } {##1}
              { \str_set:Ne \l__leanquote_srcpath_str { \l_leanquote_root_tl \str_range:nnn {##1} {10} {-1} } }
          }
        \ior_close:N \g__leanquote_ior
        \tl_if_blank:VF \l_leanquote_source_tl
          { \str_set:NV \l__leanquote_srcpath_str \l_leanquote_source_tl }
        \file_if_exist:nT { \l__leanquote_srcpath_str }
          {
            \str_clear:N \l__leanquote_current_str
            \ior_open:Nn \g__leanquote_ior { \l__leanquote_srcpath_str }
            \ior_str_map_inline:Nn \g__leanquote_ior
              { \str_put_right:Nn \l__leanquote_current_str { ##1 | } }
            \ior_close:N \g__leanquote_ior
            \str_if_eq:NNF \l__leanquote_stored_str \l__leanquote_current_str
              { \msg_warning:nnVn { leanquote } { stale } \l__leanquote_srcpath_str {#1} }
          }
      }
  }

% Is the export #1 up to date with the source #2? Sets \l__leanquote_fresh_bool; cached per run.
\bool_new:N \l__leanquote_fresh_bool
\prop_new:N \g__leanquote_fresh_prop
\cs_new_protected:Npn \__leanquote_export_fresh:nn #1#2
  {
    \prop_get:NnNTF \g__leanquote_fresh_prop {#1} \l_tmpb_tl
      { \bool_set:Nn \l__leanquote_fresh_bool { \tl_if_eq_p:Nn \l_tmpb_tl { 1 } } }
      {
        \str_clear:N \l__leanquote_stored_str
        \ior_open:Nn \g__leanquote_ior {#1}
        \ior_str_map_inline:Nn \g__leanquote_ior
          {
            \regex_match:nnT { \A @@src\x{20} } {##1}
              { \str_put_right:Ne \l__leanquote_stored_str { \str_range:nnn {##1} {7} {-1} | } }
            \regex_match:nnT { \A @@src \Z } {##1}
              { \str_put_right:Nn \l__leanquote_stored_str { | } }
          }
        \ior_close:N \g__leanquote_ior
        \str_clear:N \l__leanquote_current_str
        \ior_open:Nn \g__leanquote_ior {#2}
        \ior_str_map_inline:Nn \g__leanquote_ior
          { \str_put_right:Nn \l__leanquote_current_str { ##1 | } }
        \ior_close:N \g__leanquote_ior
        \str_if_eq:NNTF \l__leanquote_stored_str \l__leanquote_current_str
          {
            \bool_set_true:N \l__leanquote_fresh_bool
            \prop_gput:Nnn \g__leanquote_fresh_prop {#1} { 1 }
            \msg_info:nnnn { leanquote } { using-export } {#2} {#1}
          }
          {
            \bool_set_false:N \l__leanquote_fresh_bool
            \prop_gput:Nnn \g__leanquote_fresh_prop {#1} { 0 }
            \msg_warning:nnnn { leanquote } { stale-fallback } {#2} {#1}
          }
      }
  }
\cs_generate_variant:Nn \__leanquote_export_fresh:nn { VV }
\cs_generate_variant:Nn \__leanquote_from_export:n { V }
\str_new:N \l__leanquote_export_str
\bool_new:N \l__leanquote_useexport_bool

% ---------------------------------------------------------------- main command
\cs_new_protected:Npn \__leanquote_typeset:nn #1#2
  {
    \str_set:Nn \l__leanquote_file_str {#1}
    \str_if_eq:eeT { \str_range:Nnn \l__leanquote_file_str {-5} {-1} } { .lean }
      { \str_set:Ne \l__leanquote_file_str { \l_leanquote_project_tl #1 } }
    \file_if_exist:VF \l__leanquote_file_str
      { \msg_error:nnV { leanquote } { no-file } \l__leanquote_file_str }
    \bool_lazy_and:nnT
      { \l_leanquote_check_bool }
      { \str_if_eq_p:ee { \str_range:Nnn \l__leanquote_file_str {-10} {-1} } { .leanquote } }
      { \__leanquote_check:n {#1} }
    \bool_lazy_and:nnT
      { \l_leanquote_check_bool }
      { \str_if_eq_p:ee { \str_range:Nnn \l__leanquote_file_str {-5} {-1} } { .lean } }
      { \exp_args:NV \__leanquote_check_compiled:nn \l__leanquote_file_str {#1} }
    \bool_set_false:N \l__leanquote_useexport_bool
    \str_if_eq:eeT { \str_range:Nnn \l__leanquote_file_str {-5} {-1} } { .lean }
      {
        \str_set:Ne \l__leanquote_export_str
          { \l_leanquote_project_tl .lake/build/leanquote/ \str_range:nnn {#1} {1} {-6} .leanquote }
        \file_if_exist:VF \l__leanquote_export_str
          {
            \str_set:Ne \l__leanquote_export_str
              { \l_leanquote_project_tl \str_range:nnn {#1} {1} {-6} .leanquote }
          }
        \file_if_exist:VT \l__leanquote_export_str
          {
            \__leanquote_export_fresh:VV \l__leanquote_export_str \l__leanquote_file_str
            \bool_set_eq:NN \l__leanquote_useexport_bool \l__leanquote_fresh_bool
          }
      }
    \int_gincr:N \g__leanquote_count_int
    \str_set:Ne \l__leanquote_out_str
      { \c_sys_jobname_str -leanquote- \int_use:N \g__leanquote_count_int .lean }
    \iow_open:Nn \g__leanquote_iow { \l__leanquote_out_str }
    \bool_set_true:N \l__leanquote_first_bool
    \clist_map_inline:nn {#2}
      {
        \tl_set:Ne \l_tmpa_tl { \tl_to_str:n {##1} }
        \tl_trim_spaces:N \l_tmpa_tl
        \str_set:NV \l__leanquote_name_str \l_tmpa_tl
        \bool_if:NF \l__leanquote_first_bool { \__leanquote_write:n { } }
        \bool_set_false:N \l__leanquote_first_bool
        \bool_if:NTF \l__leanquote_useexport_bool
          { \__leanquote_from_export:V \l__leanquote_export_str }
          {
            \str_if_eq:eeTF { \str_range:Nnn \l__leanquote_file_str {-5} {-1} } { .lean }
              { \exp_args:NV \__leanquote_from_source:n \l__leanquote_file_str }
              { \__leanquote_from_export:n {#1} }
          }
        \bool_if:NF \l__leanquote_found_bool
          { \msg_error:nnVV { leanquote } { not-found } \l__leanquote_name_str \l__leanquote_file_str }
        \int_compare:nNnT { \l__leanquote_matches_int } > { 1 }
          { \msg_warning:nnVn { leanquote } { ambiguous } \l__leanquote_name_str {#1} }
      }
    \iow_close:N \g__leanquote_iow
    \bool_if:NT \l_leanquote_box_bool { \begin{leanquotebox} }
    \use:e
      {
        \exp_not:N \lstinputlisting
          [ style = \l_leanquote_style_tl \exp_not:V \l__leanquote_lst_tl ]
          { \l__leanquote_out_str }
      }
    \bool_if:NT \l_leanquote_box_bool { \end{leanquotebox} }
  }
% \leanfilequote[options]{file}{names}: quote declarations from an explicit file.
\NewDocumentCommand \leanfilequote { O{} m m }
  {
    \group_begin:
      \tl_clear:N \l__leanquote_lst_tl
      \keys_set:nn { leanquote } {#1}
      \__leanquote_typeset:nn {#2} {#3}
    \group_end:
  }
% \leanfile[options]{file}: set the current file (and options) for the following \leanquote.
\tl_new:N \l_leanquote_file_tl
\tl_new:N \l__leanquote_fileopts_tl
\msg_new:nnn { leanquote } { no-current-file }
  { \token_to_str:N \leanquote\ used~before~any~\token_to_str:N \leanfile. }
\NewDocumentCommand \leanfile { O{} m }
  {
    \tl_set:Nn \l_leanquote_file_tl {#2}
    \tl_set:Nn \l__leanquote_fileopts_tl {#1}
  }
