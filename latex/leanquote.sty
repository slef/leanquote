\seq_new:N \l__leanquote_buf_seq
\cs_new_protected:Npn \__leanquote_write:n #1 { \seq_put_right:Nn \l__leanquote_buf_seq {#1} }

% ---------------------------------------------------------------- lexical scanning
% Mask comments and strings with spaces, keeping byte/character offsets into the original.
% Block comments and literal contexts persist across lines, including interpolation holes.
% Consumers use the mask for syntax and source offsets. Imports omit masked comments;
% declaration text stays untouched. This is a source fallback, not a Lean parser.
\str_new:N \l__leanquote_code_str
\str_new:N \l__leanquote_char_str
\str_new:N \l__leanquote_pair_str
\str_new:N \l__leanquote_tail_str
\str_new:N \l__leanquote_rawend_str
\seq_new:N \l__leanquote_literal_seq
% Stack: ordinary/interpolated/raw strings, interpolation holes, and braces in holes.
\seq_new:N \l__leanquote_context_seq
\str_new:N \l__leanquote_context_str
\bool_new:N \l__leanquote_interpolated_bool
\int_new:N \l__leanquote_message_args_int
\int_new:N \l__leanquote_message_depth_int
\bool_new:N \l__leanquote_message_atom_bool
\int_new:N \l__leanquote_hole_start_int
\bool_new:N \l__leanquote_hole_bool
\int_new:N \l__leanquote_comment_int
\int_new:N \l__leanquote_scan_int
\int_new:N \l__leanquote_length_int
\bool_new:N \l__leanquote_string_bool
\bool_new:N \l__leanquote_escape_bool
\bool_new:N \l__leanquote_continuation_bool
\bool_new:N \l__leanquote_string_continuation_bool
\bool_new:N \l__leanquote_literal_bool
\bool_new:N \l__leanquote_proof_scan_bool
% The listings renderer uses the same lexical decisions, with one class per
% source byte (pdfTeX) or character (Unicode engines): code, string, comment, name.
\str_new:N \l__leanquote_classes_str
% Lexical classes: code, string/character, block comment, line comment, escaped name.
% The separate line-comment class gates listings' native TeX-comment mode.
\str_new:N \l__leanquote_class_str
\int_new:N \l__leanquote_class_start_int
\cs_new_protected:Npn \__leanquote_lex_reset:
  {
    \int_zero:N \l__leanquote_comment_int
    \seq_clear:N \l__leanquote_context_seq
    \bool_set_false:N \l__leanquote_interpolated_bool
    \int_set:Nn \l__leanquote_message_args_int {-1}
    \int_zero:N \l__leanquote_message_depth_int
    \bool_set_false:N \l__leanquote_message_atom_bool
    \bool_set_false:N \l__leanquote_string_bool
    \bool_set_false:N \l__leanquote_escape_bool
    \bool_set_false:N \l__leanquote_proof_scan_bool
    \str_clear:N \l__leanquote_rawend_str
  }
\cs_new_protected:Npn \__leanquote_mask_literal:
  {
    \int_set:Nn \l_tmpa_int { \str_count:e { \seq_item:Nn \l__leanquote_literal_seq {1} } }
    \str_put_right:Ne \l__leanquote_code_str
      { \prg_replicate:nn { \l_tmpa_int } { \c_space_tl } }
    \int_add:Nn \l__leanquote_scan_int { \l_tmpa_int - 1 }
    \bool_set_true:N \l__leanquote_literal_bool
  }
\cs_new_protected:Npn \__leanquote_lex_code:N #1
  {
    \__leanquote_message_char:
    \bool_set_false:N \l__leanquote_literal_bool
    \str_case:Vn \l__leanquote_char_str
      {
        {"}
          {
            \bool_if:NTF \l__leanquote_interpolated_bool
              { \seq_put_right:Nn \l__leanquote_context_seq {interpolated} }
              { \seq_put_right:Nn \l__leanquote_context_seq {string} }
            \bool_set_false:N \l__leanquote_interpolated_bool
            \bool_set_true:N \l__leanquote_literal_bool
            \str_set:Nn \l__leanquote_class_str {s}
            \str_put_right:Ne \l__leanquote_code_str { \c_space_tl }
          }
        {r}
          {
            \str_set:Ne \l__leanquote_tail_str { \str_range:Nnn #1 { \l__leanquote_scan_int } {-1} }
            \regex_extract_once:nVNTF { \A r (\x{23}*) " } \l__leanquote_tail_str \l__leanquote_literal_seq
              {
                \str_set:Ne \l__leanquote_rawend_str { " \seq_item:Nn \l__leanquote_literal_seq {2} }
                \bool_set_false:N \l__leanquote_interpolated_bool
                \seq_put_right:Nn \l__leanquote_context_seq {raw}
                \str_set:Nn \l__leanquote_class_str {s}
                \__leanquote_mask_literal:
              }
              { }
          }
        {'}
          {
            % Identifier tokens, including apostrophes, are consumed together.
            \str_set:Ne \l__leanquote_tail_str { \str_range:Nnn #1 { \l__leanquote_scan_int } {-1} }
            \regex_extract_once:nVNTF { \A ' (?: [^'\\] | \\ . )+ ' }
              \l__leanquote_tail_str \l__leanquote_literal_seq
              { \str_set:Nn \l__leanquote_class_str {s}
                \bool_set_false:N \l__leanquote_interpolated_bool \__leanquote_mask_literal: } { }
          }
      }
    \bool_if:NF \l__leanquote_literal_bool
      {
        % In pdfTeX the delimiter occupies two bytes, in Unicode engines one.
        \bool_lazy_or:nnTF
          { \str_if_eq_p:Vn \l__leanquote_char_str {«} }
          { \str_if_eq_p:Vn \l__leanquote_pair_str {«} }
          {
            \str_set:Nn \l__leanquote_class_str {i}
            \str_set:Ne \l__leanquote_tail_str { \str_range:Nnn #1 { \l__leanquote_scan_int } {-1} }
            \regex_extract_once:nVNTF { \A « .*? » } \l__leanquote_tail_str \l__leanquote_literal_seq
              {
                \bool_set_false:N \l__leanquote_interpolated_bool
                \bool_if:NTF \l__leanquote_proof_scan_bool
                  { \__leanquote_mask_literal: }
                  {
                    \str_put_right:Ne \l__leanquote_code_str { \seq_item:Nn \l__leanquote_literal_seq {1} }
                    \int_add:Nn \l__leanquote_scan_int
                      { \str_count:e { \seq_item:Nn \l__leanquote_literal_seq {1} } - 1 }
                  }
              }
              {
                % An escaped name may span lines. Its contents cannot start
                % declarations, strings, or comments on subsequent lines.
                \seq_put_right:Nn \l__leanquote_context_seq {identifier}
                \str_put_right:Ne \l__leanquote_code_str
                  { \prg_replicate:nn { \str_count:N \l__leanquote_tail_str } { \c_space_tl } }
                \int_set_eq:NN \l__leanquote_scan_int \l__leanquote_length_int
              }
          }
          { \__leanquote_lex_identifier:N #1 }
      }
  }
\int_new:N \l__leanquote_identifier_pos_int
\int_new:N \l__leanquote_identifier_cp_int
\int_new:N \l__leanquote_identifier_end_int
\str_new:N \l__leanquote_identifier_str
\cs_new_protected:Npn \__leanquote_message_space:
  {
    \bool_if:nT
      { \l__leanquote_message_atom_bool &&
        \int_compare_p:nNn { \l__leanquote_message_args_int } > {0} &&
        \int_compare_p:nNn { \l__leanquote_message_depth_int } = {0} }
      {
        \int_decr:N \l__leanquote_message_args_int
        \bool_set_false:N \l__leanquote_message_atom_bool
      }
  }
\cs_new_protected:Npn \__leanquote_message_char:
  {
    \int_compare:nNnT { \l__leanquote_message_args_int } > {-1}
      {
        \regex_match:nVTF { \A \s \Z } \l__leanquote_char_str
          { \__leanquote_message_space: }
          {
            \str_if_eq:VnT \l__leanquote_char_str {"}
              { \__leanquote_message_space: }
            \int_compare:nNnTF { \l__leanquote_message_args_int } = {0}
              {
                \str_if_eq:VnT \l__leanquote_char_str {"}
                  { \bool_set_true:N \l__leanquote_interpolated_bool }
                \int_set:Nn \l__leanquote_message_args_int {-1}
              }
              {
                \bool_set_true:N \l__leanquote_message_atom_bool
                \str_case:Vn \l__leanquote_char_str
                  {
                    {(} { \int_incr:N \l__leanquote_message_depth_int }
                    {[} { \int_incr:N \l__leanquote_message_depth_int }
                    {)} { \int_decr:N \l__leanquote_message_depth_int }
                    {]} { \int_decr:N \l__leanquote_message_depth_int }
                    {;} { \int_set:Nn \l__leanquote_message_args_int {-1} }
                  }
                \str_if_eq:eeT { \l__leanquote_char_str } { \c_left_brace_str }
                  { \int_incr:N \l__leanquote_message_depth_int }
                \str_if_eq:eeT { \l__leanquote_char_str } { \c_right_brace_str }
                  { \int_decr:N \l__leanquote_message_depth_int }
              }
          }
      }
  }
\cs_new_protected:Npn \__leanquote_message_prefix:N #1
  {
    % Built-in message syntax accepts interpolation without an exclamation mark.
    % Count its preceding atomic arguments; brackets keep their contents separate
    % from the message. Qualified calls such as Lean.throwError are ordinary terms.
    \bool_if:nT
      { \int_compare_p:nNn { \l__leanquote_message_args_int } < {0} &&
        ! \str_if_eq_p:ee { \str_item:Nn #1 { \l__leanquote_scan_int - 1 } } {.} }
      {
        \str_case:Vn \l__leanquote_identifier_str
          {
            {dbg_trace} { \int_zero:N \l__leanquote_message_args_int }
            {throwError} { \int_zero:N \l__leanquote_message_args_int }
            {throwErrorAt} { \int_set:Nn \l__leanquote_message_args_int {1} }
            {throwNamedError} { \int_set:Nn \l__leanquote_message_args_int {1} }
            {throwNamedErrorAt} { \int_set:Nn \l__leanquote_message_args_int {2} }
            {logNamedError} { \int_set:Nn \l__leanquote_message_args_int {1} }
            {logNamedErrorAt} { \int_set:Nn \l__leanquote_message_args_int {2} }
            {logNamedWarning} { \int_set:Nn \l__leanquote_message_args_int {1} }
            {logNamedWarningAt} { \int_set:Nn \l__leanquote_message_args_int {2} }
            {trace}
              {
                \str_if_eq:eeT { \str_item:Nn #1 { \l__leanquote_identifier_end_int + 1 } } {[}
                  { \int_set:Nn \l__leanquote_message_args_int {1} }
              }
          }
        \int_zero:N \l__leanquote_message_depth_int
        \bool_set_false:N \l__leanquote_message_atom_bool
      }
  }
\cs_new_protected:Npn \__leanquote_lex_identifier:N #1
  {
    \int_set_eq:NN \l__leanquote_identifier_pos_int \l__leanquote_scan_int
    \__leanquote_decode:NNN #1 \l__leanquote_identifier_pos_int \l__leanquote_identifier_cp_int
    \__leanquote_id_first:nTF { \l__leanquote_identifier_cp_int }
      {
        \int_set_eq:NN \l__leanquote_identifier_end_int \l__leanquote_identifier_pos_int
        \int_incr:N \l__leanquote_identifier_pos_int
        \int_while_do:nNnn { \l__leanquote_identifier_pos_int } < { \str_count:N #1 + 1 }
          {
            \__leanquote_decode:NNN #1 \l__leanquote_identifier_pos_int \l__leanquote_identifier_cp_int
            \__leanquote_id:nTF { \l__leanquote_identifier_cp_int }
              { \int_set_eq:NN \l__leanquote_identifier_end_int \l__leanquote_identifier_pos_int }
              { \int_set:Nn \l__leanquote_identifier_pos_int { \str_count:N #1 + 1 } }
            \int_incr:N \l__leanquote_identifier_pos_int
          }
        \str_set:Ne \l__leanquote_identifier_str
          { \str_range:Nnn #1 { \l__leanquote_scan_int } { \l__leanquote_identifier_end_int } }
        \str_put_right:NV \l__leanquote_code_str \l__leanquote_identifier_str
        \__leanquote_message_prefix:N #1
        \bool_set_false:N \l__leanquote_interpolated_bool
        \bool_if:nT
          {
            ! \str_if_eq_p:ee { \str_item:Nn #1 { \l__leanquote_scan_int - 1 } } {.} &&
            ! \str_if_eq_p:ee { \str_item:Nn #1 { \l__leanquote_identifier_end_int + 1 } } {.}
          }
          {
            \str_case:Vn \l__leanquote_identifier_str
              {
                {s!} { \bool_set_true:N \l__leanquote_interpolated_bool }
                {m!} { \bool_set_true:N \l__leanquote_interpolated_bool }
                {f!} { \bool_set_true:N \l__leanquote_interpolated_bool }
                {println!} { \bool_set_true:N \l__leanquote_interpolated_bool }
                {reportIssue!} { \bool_set_true:N \l__leanquote_interpolated_bool }
                {reportDbgIssue!} { \bool_set_true:N \l__leanquote_interpolated_bool }
                {reportEMatchIssue!} { \bool_set_true:N \l__leanquote_interpolated_bool }
              }
          }
        \int_set_eq:NN \l__leanquote_scan_int \l__leanquote_identifier_end_int
      }
      { \__leanquote_lex_plain: }
  }
\cs_new_protected:Npn \__leanquote_lex_plain:
  {
    \str_put_right:NV \l__leanquote_code_str \l__leanquote_char_str
