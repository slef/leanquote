#!/bin/sh
# Optional: build Lean modules and export their declarations for the leandecl LaTeX package.
# Usage (from the root of the Lake project):  leandecl-export MODULE [MODULE ...]
# Writes .lake/build/leandecl/<path of the module>.leandecl, where \leandecl finds it
# automatically (with project= set to this directory). Without an export, \leandecl reads the
# .lean file directly; with one, it uses Lean's exact declaration boundaries.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
for module in "$@"; do
  rel=$(echo "$module" | tr . /).lean
  src=$rel
  [ -f "$src" ] || src=$(find . -path ./.lake -prune -o -path "*/$rel" -print | head -1 | sed 's|^\./||')
  [ -n "$src" ] && [ -f "$src" ] || { echo "leandecl-export: no source file for $module" >&2; exit 1; }
  out=.lake/build/leandecl/${src%.lean}.leandecl
  mkdir -p "$(dirname "$out")"
  lake build "$module"
  lake env lean --run "$here/lean/LeanDeclExport.lean" "$module" "$src" "$out"
done
