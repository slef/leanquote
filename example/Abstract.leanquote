@@leanquote-export 3
@@module TranslationTiling.Abstract
@@source TranslationTiling/Abstract.lean
@@olean .lake/build/lib/lean/TranslationTiling/Abstract.olean
@@trace f5ea17cde6ff0886
@@begin TranslationTiling.Abstract.Point
@@axioms
@@kind declaration
@@doc /-- A point of `ℤ³`. -/
@@code abbrev Point := Fin 3 → ℤ
@@end
@@begin TranslationTiling.Abstract.Prototile
@@axioms
@@kind declaration
@@doc /-- A prototile: a finite set of points of `ℤ³`, given as a list. -/
@@code abbrev Prototile := List Point
@@end
@@begin TranslationTiling.Abstract.Adjacent
@@axioms propext Classical.choice Quot.sound
@@kind declaration
@@doc /-- Two points are adjacent when their `ℓ¹` distance is one. -/
@@code def Adjacent (a b : Point) : Prop :=
@@code   ∑ i, |a i - b i| = 1
@@end
@@begin TranslationTiling.Abstract.Connected
@@axioms propext Classical.choice Quot.sound
@@kind declaration
@@doc /-- `P` is (face-)connected: any two of its points are joined by a path of
@@doc adjacent points inside `P`. -/
@@code def Connected (P : Prototile) : Prop :=
@@code   ∀ p ∈ P, ∀ q ∈ P, Relation.ReflTransGen (fun a b => a ∈ P ∧ b ∈ P ∧ Adjacent a b) p q
@@end
@@begin TranslationTiling.Abstract.Tiles
@@axioms
@@kind declaration
@@doc /-- `P` tiles `ℤ³`: for some set `T` of translations, every point `x` lies in exactly
@@doc one translate `t + P` with `t ∈ T`, i.e., for exactly one `t ∈ T` we have `x - t ∈ P`. -/
@@code def Tiles (P : Prototile) : Prop :=
@@code   ∃ T : Set Point, ∀ x : Point, ∃! t : Point, t ∈ T ∧ x - t ∈ P
@@end
@@begin TranslationTiling.Abstract.tiling_coRE_complete
@@axioms propext Classical.choice Quot.sound
@@kind theorem
@@doc /-- **Main theorem.** Deciding whether a connected prototile in `ℤ³` tiles space is
@@doc co-r.e.-complete: the non-tilers are recursively enumerable, and every co-r.e.
@@doc problem many-one reduces (computably) to it. -/
@@code theorem tiling_coRE_complete : LeanWang.CoREComplete fun P => Connected P ∧ Tiles P :=
@@code   AbstractBridge.connected_coRE_complete
@@statement theorem tiling_coRE_complete : LeanWang.CoREComplete fun P => Connected P ∧ Tiles P := ...
@@end
@@begin TranslationTiling.Abstract.tiling_undecidable
@@axioms propext Classical.choice Quot.sound
@@kind theorem
@@doc /-- **Corollary.** No algorithm decides whether a connected prototile in `ℤ³`
@@doc tiles space. (Mathlib notions only.) -/
@@code theorem tiling_undecidable : ¬ ComputablePred fun P => Connected P ∧ Tiles P :=
@@code   AbstractBridge.connected_undecidable
@@statement theorem tiling_undecidable : ¬ ComputablePred fun P => Connected P ∧ Tiles P := ...
@@end
@@begin TranslationTiling.Abstract.RealPoint
@@axioms propext Classical.choice Quot.sound
@@kind declaration
@@doc /-- A point of `ℝ³`. -/
@@code abbrev RealPoint := Fin 3 → ℝ
@@end
@@begin TranslationTiling.Abstract.Solid
@@axioms propext Classical.choice Quot.sound
@@kind declaration
@@doc /-- The solid body of a prototile: the union of the unit cubes `p + [0, 1]³`, `p ∈ P`. -/
@@code def Solid (P : Prototile) : Set RealPoint :=
@@code   {x | ∃ p ∈ P, ∀ i, p i ≤ x i ∧ x i ≤ p i + 1}
@@end
@@begin TranslationTiling.Abstract.RealTiles
@@axioms propext Classical.choice Quot.sound
@@kind declaration
@@doc /-- The solid body of `P` tiles `ℝ³` by translations: for some set `T ⊆ ℝ³` of
@@doc (arbitrary real) translations, almost every point `x` of `ℝ³` lies in exactly one
@@doc translate `t + Solid P` with `t ∈ T`. -/
@@code def RealTiles (P : Prototile) : Prop :=
@@code   ∃ T : Set RealPoint, ∀ᵐ x ∂MeasureTheory.volume, ∃! t : RealPoint, t ∈ T ∧ x - t ∈ Solid P
@@end
@@begin TranslationTiling.Abstract.real_tiling_coRE_complete
@@axioms propext Classical.choice Quot.sound
@@kind theorem
@@doc /-- Deciding whether the solid body of a connected prototile tiles `ℝ³` by arbitrary
@@doc real translations is co-r.e.-complete. -/
@@code theorem real_tiling_coRE_complete : LeanWang.CoREComplete fun P => Connected P ∧ RealTiles P :=
@@code   AbstractBridge.connected_real_coRE_complete
@@statement theorem real_tiling_coRE_complete : LeanWang.CoREComplete fun P => Connected P ∧ RealTiles P := ...
@@end
@@begin TranslationTiling.Abstract.real_tiling_undecidable
@@axioms propext Classical.choice Quot.sound
@@kind theorem
@@doc /-- No algorithm decides whether a connected prototile tiles `ℝ³` by arbitrary
@@doc real translations. (Mathlib notions only.) -/
@@code theorem real_tiling_undecidable : ¬ ComputablePred fun P => Connected P ∧ RealTiles P :=
@@code   AbstractBridge.connected_real_undecidable
@@statement theorem real_tiling_undecidable : ¬ ComputablePred fun P => Connected P ∧ RealTiles P := ...
@@end
@@src import Mathlib.Computability.Halting
@@src import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
@@src import LeanWang.CoRE
@@src import TranslationTiling.AbstractBridge
@@src 
@@src /-!
@@src # The 3D tiling problem
@@src 
@@src A *prototile* is a finite list of points of `ℤ³`. It *tiles space* if `ℤ³` can be
@@src partitioned into translates of it: there is a set `T` of translation vectors such
@@src that every point of `ℤ³` lies in exactly one translate `t + P` with `t ∈ T`.
@@src 
@@src We show that deciding whether a *connected* prototile tiles is co-r.e.-complete,
@@src both for `ℤ³` and for the solid body in `ℝ³` (union of unit cubes, arbitrary real
@@src translations). The proofs invoke `TranslationTiling.AbstractBridge`, which connects
@@src the statements to the rest of the project.
@@src -/
@@src 
@@src namespace TranslationTiling.Abstract
@@src 
@@src /-- A point of `ℤ³`. -/
@@src abbrev Point := Fin 3 → ℤ
@@src 
@@src /-- A prototile: a finite set of points of `ℤ³`, given as a list. -/
@@src abbrev Prototile := List Point
@@src 
@@src /-- Two points are adjacent when their `ℓ¹` distance is one. -/
@@src def Adjacent (a b : Point) : Prop :=
@@src   ∑ i, |a i - b i| = 1
@@src 
@@src /-- `P` is (face-)connected: any two of its points are joined by a path of
@@src adjacent points inside `P`. -/
@@src def Connected (P : Prototile) : Prop :=
@@src   ∀ p ∈ P, ∀ q ∈ P, Relation.ReflTransGen (fun a b => a ∈ P ∧ b ∈ P ∧ Adjacent a b) p q
@@src 
@@src /-! ### Tiling `ℤ³` -/
@@src 
@@src /-- `P` tiles `ℤ³`: for some set `T` of translations, every point `x` lies in exactly
@@src one translate `t + P` with `t ∈ T`, i.e., for exactly one `t ∈ T` we have `x - t ∈ P`. -/
@@src def Tiles (P : Prototile) : Prop :=
@@src   ∃ T : Set Point, ∀ x : Point, ∃! t : Point, t ∈ T ∧ x - t ∈ P
@@src 
@@src /-- **Main theorem.** Deciding whether a connected prototile in `ℤ³` tiles space is
@@src co-r.e.-complete: the non-tilers are recursively enumerable, and every co-r.e.
@@src problem many-one reduces (computably) to it. -/
@@src theorem tiling_coRE_complete : LeanWang.CoREComplete fun P => Connected P ∧ Tiles P :=
@@src   AbstractBridge.connected_coRE_complete
@@src 
@@src /-- **Corollary.** No algorithm decides whether a connected prototile in `ℤ³`
@@src tiles space. (Mathlib notions only.) -/
@@src theorem tiling_undecidable : ¬ ComputablePred fun P => Connected P ∧ Tiles P :=
@@src   AbstractBridge.connected_undecidable
@@src 
@@src /-! ### Tiling `ℝ³` -/
@@src 
@@src /-- A point of `ℝ³`. -/
@@src abbrev RealPoint := Fin 3 → ℝ
@@src 
@@src /-- The solid body of a prototile: the union of the unit cubes `p + [0, 1]³`, `p ∈ P`. -/
@@src def Solid (P : Prototile) : Set RealPoint :=
@@src   {x | ∃ p ∈ P, ∀ i, p i ≤ x i ∧ x i ≤ p i + 1}
@@src 
@@src /-- The solid body of `P` tiles `ℝ³` by translations: for some set `T ⊆ ℝ³` of
@@src (arbitrary real) translations, almost every point `x` of `ℝ³` lies in exactly one
@@src translate `t + Solid P` with `t ∈ T`. -/
@@src def RealTiles (P : Prototile) : Prop :=
@@src   ∃ T : Set RealPoint, ∀ᵐ x ∂MeasureTheory.volume, ∃! t : RealPoint, t ∈ T ∧ x - t ∈ Solid P
@@src 
@@src /-- Deciding whether the solid body of a connected prototile tiles `ℝ³` by arbitrary
@@src real translations is co-r.e.-complete. -/
@@src theorem real_tiling_coRE_complete : LeanWang.CoREComplete fun P => Connected P ∧ RealTiles P :=
@@src   AbstractBridge.connected_real_coRE_complete
@@src 
@@src /-- No algorithm decides whether a connected prototile tiles `ℝ³` by arbitrary
@@src real translations. (Mathlib notions only.) -/
@@src theorem real_tiling_undecidable : ¬ ComputablePred fun P => Connected P ∧ RealTiles P :=
@@src   AbstractBridge.connected_real_undecidable
@@src 
@@src end TranslationTiling.Abstract
